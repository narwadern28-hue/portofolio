# ALEX WEB DESIGN — environment template (NO real values here).
#
# Antideploy injects RESEND_API_KEY, RESEND_BASE_URL and EMAIL_FROM into the
# running container automatically once email is enabled for the application.
# You do NOT need to fill these in yourself on Antideploy.
#
# For local testing of the contact API, copy this file to `.env` and fill in
# values obtained from the Antideploy dashboard/CLI for your app. `.env` is
# git-ignored — never commit real keys.

# Token for Antideploy's email relay (provided by the platform).
RESEND_API_KEY=

# Relay endpoint read automatically by the `resend` SDK (provided by platform).
RESEND_BASE_URL=

# Ready-made From value (provided by the platform).
EMAIL_FROM=

# Where project enquiries are delivered. Defaults to webdesigner.rn@gmail.com
# when unset, so this line is optional.
CONTACT_TO_EMAIL=webdesigner.rn@gmail.com

# Port the server listens on. Antideploy sets PORT at runtime.
PORT=3000
